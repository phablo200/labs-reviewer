# OpenAI
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Model configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3

LLM_POST_WRITER_PROVIDER=openai
LLM_POST_WRITER_MODEL=gpt-4o-mini
LLM_POST_WRITER_TEMPERATURE=0.7

LLM_CODE_EXAMPLE_PROVIDER=groq
LLM_CODE_EXAMPLE_MODEL=llama-3.1-8b-instant
LLM_CODE_EXAMPLE_TEMPERATURE=0.3

LLM_REVIEWER_PROVIDER=groq
LLM_REVIEWER_MODEL=llama-3.1-8b-instant
LLM_REVIEWER_TEMPERATURE=0.3

LLM_METADATA_PROVIDER=groq
LLM_METADATA_MODEL=llama-3.1-8b-instant
LLM_METADATA_TEMPERATURE=0.3

LLM_TRANSLATOR_PROVIDER=openai
LLM_TRANSLATOR_MODEL=gpt-4o-mini
LLM_TRANSLATOR_TEMPERATURE=0.7

# App config
APP_ENV=development
APP_PORT=3015

LANGCHAIN_API_KEY=""
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="LabsReviewer"

GITHUB_TOKEN=

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=labs_reviewer

# Task dispatch
# Supported values: background_tasks, celery
TASK_DISPATCHER=background_tasks
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_MODULES=labs.tasks.celery_tasks

# Auth integration
# AUTH_JWT_SECRET must match auth-service JWT_SECRET.
AUTH_TOKEN_VERIFIER=jwt
AUTH_JWT_SECRET=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWKS_URL=
AUTH_EXPECTED_APPLICATION_ID=00000000-0000-0000-0000-000000000002
